# Inputs and outputs (datasets/, lora-finetuned/, live_downstream/, ...)
NM_ROOT=/data/new_master
HF_HOME=/data/huggingface

# Hugging Face repos used by the paper
ABLITERATED_MODEL=lenalibon/Meta-Llama-3-8B-Instruct-heretic-mlabonne
PROBE_COMPLETIONS_DATASET=lenalibon/jailbreak-judge-completions

# Weights & Biases (or WANDB_MODE=offline)
WANDB_ENTITY=YOUR_WANDB_ENTITY
WANDB_PROJECT=polytope-training

# OpenAI-compatible judge endpoint (StrongREJECT rubric and MASK grading)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://opencode.ai/zen/v1
JUDGE_MODEL=deepseek-v4-flash

# Only for the completion-category judge in src/probe_analysis/
OPENAI_API_KEY=
